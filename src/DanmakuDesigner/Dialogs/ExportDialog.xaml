<Window x:Class="ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="导出解决方案" Width="620" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Background="#1E1E1E">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="#454548" BorderThickness="1" Background="#1E1E1E">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
                <Grid Margin="12,0,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/Export_16x.png" Width="16" Height="16" Margin="0,0,7,0" />
                        <TextBlock Text="导出完整 AgSTG 解决方案" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource VS.IconButton}" Click="Cancel_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Width="30" Height="30">
                        <Image Source="/Assets/Icons/Close_12x_16x.png" Width="12" Height="12" />
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="18,14,18,10">
                <TextBlock Text="导出目录" FontSize="10" Foreground="#8A8A8A" Margin="0,0,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FolderBox" Height="26" VerticalContentAlignment="Center" />
                    <Button Grid.Column="1" Content="浏览…" Style="{StaticResource VS.Button}" Margin="8,0,0,0" Padding="12,3" Click="Browse_Click" />
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="游戏代码名 / 输出文件夹名" FontSize="10" Foreground="#8A8A8A" Margin="0,0,0,4" />
                        <TextBox x:Name="ClassBox" Height="26" VerticalContentAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="内置引擎模板（只读）" FontSize="10" Foreground="#8A8A8A" Margin="0,0,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="EngineBox" Height="26" VerticalContentAlignment="Center" IsReadOnly="True" />
                            <Button Grid.Column="1" Content="…" Style="{StaticResource VS.Button}" Margin="6,0,0,0" Padding="8,3" Click="BrowseEngine_Click" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <Border Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="将生成以下文件" FontSize="11" FontWeight="SemiBold" Foreground="#DCDCDC" />
                        <TextBlock x:Name="FilesText" FontSize="10" Foreground="#9A9A9A" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="17" />
                        <Border Height="1" Background="#3A3A3D" Margin="0,8,0,8" />
                        <TextBlock x:Name="IssuesText" FontSize="10" Foreground="#DCDCAA" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <CheckBox x:Name="OpenFolderCheck" Content="导出完成后打开文件夹" IsChecked="True" Margin="0,12,0,0" />
                <TextBlock Text="会解压内置引擎并替换旧关卡与 ResourcePack.TH07，改写 TH07 外壳并输出完整解决方案；AgSTG 和 ResourcePack 保持原样。"
                           FontSize="10" Foreground="#7A7A7A" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="16" />
                <TextBlock x:Name="ErrorText" FontSize="10.5" Foreground="#F14C4C" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
            </StackPanel>

            <Border Grid.Row="2" Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,1,0,0" Padding="12,9">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource VS.Button}" Width="86" Margin="0,0,8,0" Click="Cancel_Click" />
                    <Button Content="导出解决方案" Style="{StaticResource VS.AccentButton}" Width="136" Click="Export_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
