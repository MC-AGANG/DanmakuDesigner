<UserControl x:Class="PreviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DanmakuDesigner"
             Background="#1E1E1E" Focusable="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="8,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="PlayButton" Style="{StaticResource VS.ToolButton}" Click="Play_Click" Height="32" Margin="0,0,2,0">
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="PlayIcon" Width="16" Height="16" Source="/Assets/Icons/Run_16xMD.png" />
                        <TextBlock x:Name="PlayText" Text="播放" Margin="6,0,2,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" x:Name="StopButton" Style="{StaticResource VS.ToolButton}" Click="Stop_Click" Height="32" ToolTip="停止并回到第 0 帧 (Shift+F5)">
                    <Image Source="/Assets/Icons/Stop_16x.png" Width="16" Height="16" />
                </Button>
                <Button Grid.Column="2" x:Name="RestartButton" Style="{StaticResource VS.ToolButton}" Click="Restart_Click" Height="32" ToolTip="从头播放 (F6)">
                    <Image Source="/Assets/Icons/Restart_16x.png" Width="16" Height="16" />
                </Button>

                <Border Grid.Column="3" Background="#464649" Margin="6,8,6,8" />

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="速度" Foreground="#9A9A9A" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="SpeedCombo" Width="76" Height="26" SelectionChanged="Speed_Changed">
                        <ComboBoxItem Content="0.5 ×" Tag="0.5" />
                        <ComboBoxItem Content="1 ×" Tag="1" />
                        <ComboBoxItem Content="2 ×" Tag="2" />
                    </ComboBox>
                </StackPanel>

                <CheckBox Grid.Column="5" x:Name="GodModeCheck" Content="无敌" Margin="0,0,10,0" VerticalAlignment="Center"
                          Checked="GodMode_Changed" Unchecked="GodMode_Changed" ToolTip="预览时不会被子弹击中" />
                <CheckBox Grid.Column="6" x:Name="HitboxCheck" Content="判定点" HorizontalAlignment="Left" VerticalAlignment="Center"
                          Checked="Display_Changed" Unchecked="Display_Changed" Margin="0,0,10,0" />
                <CheckBox Grid.Column="7" x:Name="GridCheck" Content="网格" VerticalAlignment="Center" Margin="0,0,8,0"
                          Checked="Display_Changed" Unchecked="Display_Changed" />
                <CheckBox Grid.Column="8" x:Name="EngineModeCheck" Content="引擎" IsChecked="True"
                          VerticalAlignment="Center" Margin="6,0,2,0"
                          Checked="EngineMode_Changed" Unchecked="EngineMode_Changed"
                          ToolTip="直接使用 AgSTG 的 STG 控件运行关卡" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="252" />
            </Grid.ColumnDefinitions>

            <Grid Background="#181818" ClipToBounds="True">
                <Viewbox Stretch="Uniform" Margin="18,14,18,14">
                    <Border BorderBrush="#3F3F46" BorderThickness="1" Background="#000000" SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" Opacity="0.45" ShadowDepth="0" Color="#000000" />
                        </Border.Effect>
                        <Grid x:Name="RendererHost" Width="384" Height="448" Background="#000000" />
                    </Border>
                </Viewbox>
                <TextBlock x:Name="PausedOverlay" Text="已暂停" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                           Margin="0,0,0,20" Foreground="#BFBFBF" FontSize="11" Visibility="Collapsed" />
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#252526" />

            <Border Grid.Column="2" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
                    <StackPanel Margin="14,12,14,16">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/Icons/PlaybackPreview_16x.png" Width="16" Height="16" Margin="0,0,7,0" />
                            <TextBlock Text="关卡预览" FontWeight="SemiBold" FontSize="12" Foreground="#E8E8E8" />
                        </StackPanel>
                        <TextBlock x:Name="StageNameText" Text="幻想乡 · 夜巡" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,2" TextWrapping="Wrap" />
                        <TextBlock x:Name="StageMetaText" Text="NORMAL · 60 秒" FontSize="11" Foreground="#9A9A9A" />

                        <Border Height="1" Background="#3F3F46" Margin="0,12,0,12" />

                        <UniformGrid Columns="2" Rows="2">
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="时间" FontSize="10" Foreground="#8A8A8A" />
                                <TextBlock x:Name="TimeValue" Text="00:00.00" FontSize="15" FontFamily="Consolas" Foreground="#DCDCAA" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="帧" FontSize="10" Foreground="#8A8A8A" />
                                <TextBlock x:Name="TickValue" Text="0 / 3600" FontSize="13" FontFamily="Consolas" Foreground="#D4D4D4" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="实体" FontSize="10" Foreground="#8A8A8A" />
                                <TextBlock x:Name="EntityValue" Text="0" FontSize="15" FontFamily="Consolas" Foreground="#CE9178" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="帧率" FontSize="10" Foreground="#8A8A8A" />
                                <TextBlock x:Name="FpsValue" Text="0 FPS" FontSize="15" FontFamily="Consolas" Foreground="#75BEFF" />
                            </StackPanel>
                        </UniformGrid>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="状态" FontSize="10" Foreground="#8A8A8A" Margin="0,0,0,3" />
                            <Border Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="2" Padding="7,4">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#6E7681" Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="StatusValue" Text="就绪" FontSize="11" Foreground="#CCCCCC" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,10">
                            <Grid Margin="0,0,0,3">
                                <TextBlock Text="帧率曲线" FontSize="10" Foreground="#8A8A8A" />
                                <TextBlock x:Name="FpsChartValue" Text="0 FPS" FontSize="10" Foreground="#75BEFF" HorizontalAlignment="Right" />
                            </Grid>
                            <local:PerformanceChart x:Name="FpsChart" Height="66" Maximum="120" />
                        </StackPanel>

                        <StackPanel Margin="0,0,0,10">
                            <Grid Margin="0,0,0,3">
                                <TextBlock Text="负载曲线（ms / 帧）" FontSize="10" Foreground="#8A8A8A" />
                                <TextBlock x:Name="LoadChartValue" Text="0.0 ms" FontSize="10" Foreground="#CE9178" HorizontalAlignment="Right" />
                            </Grid>
                            <local:PerformanceChart x:Name="LoadChart" Height="66" Maximum="50" />
                        </StackPanel>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="音乐" FontSize="10" Foreground="#8A8A8A" Margin="0,0,0,3" />
                            <TextBlock x:Name="MusicValue" Text="—" FontSize="11" Foreground="#DCDCAA" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Height="1" Background="#3F3F46" Margin="0,2,0,10" />

                        <TextBlock Text="调试工具" FontSize="10" Foreground="#8A8A8A" Margin="0,0,0,6" />
                        <WrapPanel>
                            <Button Content="造成伤害" Style="{StaticResource VS.Button}" Padding="9,3" Margin="0,0,6,6"
                                    Click="Damage_Click" ToolTip="对所有敌机造成 15% 最大血量的伤害，用于测试血量阶段" />
                            <Button Content="清除子弹" Style="{StaticResource VS.Button}" Padding="9,3" Margin="0,0,6,6"
                                    Click="ClearBullets_Click" />
                        </WrapPanel>

                        <TextBlock Text="操作：方向键移动，Shift 低速，Space 播放/暂停，R 重新开始。预览使用编辑器内置解释器，与导出代码语义一致。"
                                   FontSize="10" Foreground="#7A7A7A" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="16" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,1,0,0" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="时间轴" FontSize="10" Foreground="#8A8A8A" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Canvas Grid.Column="1" x:Name="SeekCanvas" Height="20" Background="Transparent" Cursor="Hand"
                        MouseLeftButtonDown="Seek_MouseDown" MouseMove="Seek_MouseMove" MouseLeftButtonUp="Seek_MouseUp">
                    <Border x:Name="SeekTrack" Height="4" Background="#3A3A3D" CornerRadius="2" VerticalAlignment="Center"
                            Canvas.Top="8" />
                    <Border x:Name="SeekFill" Height="4" Background="#007ACC" CornerRadius="2" VerticalAlignment="Center"
                            Canvas.Top="8" />
                    <Border x:Name="SeekThumb" Width="10" Height="14" Background="#F1F1F1" CornerRadius="2"
                            Canvas.Top="3" />
                </Canvas>
                <TextBlock Grid.Column="2" Text="点击或拖动此处跳转预览" FontSize="10" Foreground="#6D6D6D" VerticalAlignment="Center" Margin="10,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
