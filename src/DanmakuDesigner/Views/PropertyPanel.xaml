<UserControl x:Class="PropertyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#252526">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource VS.PanelHeaderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="/Assets/Icons/Property_16x.png" Width="16" Height="16" Margin="0,0,7,0" />
                <TextBlock Grid.Column="1" Text="属性" Style="{StaticResource VS.PanelTitle}" />
                <TextBlock x:Name="KindText" Grid.Column="2" Text="关卡" FontSize="10" Foreground="#8A8A8A" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
            <StackPanel x:Name="Host" Margin="12,8,12,18" />
        </ScrollViewer>
    </Grid>
</UserControl>
