<Window x:Class="CameraViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="选择 3D 视角" Width="960" Height="680" MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterOwner" WindowStyle="None" Background="#1E1E1E"
        ResizeMode="CanResize" ShowInTaskbar="False" Focusable="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="#454548" BorderThickness="1" Background="#1E1E1E">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <Border Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
                <Grid Margin="12,0,2,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/Media_16x.png" Width="16" Height="16" Margin="0,0,7,0" />
                        <TextBlock Text="选择 3D 视角" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="LayerTitleText" FontSize="10.5" Foreground="#8A8A8A" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource VS.IconButton}" Click="Cancel_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Width="30" Height="30">
                        <Image Source="/Assets/Icons/Close_12x_16x.png" Width="12" Height="12" />
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="12" Background="Black" BorderBrush="#3F3F46" BorderThickness="1"
                    x:Name="ViewportHost" ClipToBounds="True" />

            <Border Grid.Row="2" Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,1,0,0" Padding="10,0">
                <Grid>
                    <TextBlock x:Name="HintText" FontSize="10.5" Foreground="#A0A0A0" VerticalAlignment="Center"
                               Text="WASD 水平移动 · Space 上升 · Shift 下降 · 移动鼠标转向 · Enter 确定 · Esc 取消" />
                    <TextBlock x:Name="PositionText" HorizontalAlignment="Right" FontSize="10" FontFamily="Consolas"
                               Foreground="#DCDCAA" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
