<UserControl x:Class="BlockEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E" Focusable="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="/Assets/Icons/Code_16x.png" Width="16" Height="16" Margin="0,0,8,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="BreadcrumbText" Text="敌机行为" FontSize="12" FontWeight="SemiBold" Foreground="#E8E8E8" />
                    <Border x:Name="ScopeBadge" Background="#3A2C4A" CornerRadius="2" Padding="5,1" Margin="8,0,0,0">
                        <TextBlock x:Name="ScopeText" Text="敌机" FontSize="9.5" Foreground="#C792EA" />
                    </Border>
                    <TextBlock x:Name="ScriptCountText" Text="0 个脚本 · 0 块" FontSize="10" Foreground="#8A8A8A" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="3" Text="拖动积木到画布 · 右键字段插入取值 · Delete 删除" FontSize="10" Foreground="#6F6F6F"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Grid.Column="4" Style="{StaticResource VS.Button}" Click="NewScript_Click" Height="26" Margin="0,0,8,0" Padding="9,2">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/Icons/Add_16x.png" Width="13" Height="13" />
                        <TextBlock Text="新脚本" Margin="5,0,0,0" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="5" Style="{StaticResource VS.ToolButton}" Click="Back_Click" Height="26" Padding="8,2" ToolTip="返回时间轴">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/Icons/Timeline_16x.png" Width="14" Height="14" />
                        <TextBlock Text="时间轴" Margin="5,0,0,0" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="0"
                          Background="#1E1E1E">
                <StackPanel x:Name="ScriptHost" Margin="26,20,26,60" AllowDrop="True" />
            </ScrollViewer>

            <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False" />

            <Border x:Name="EmptyCard" HorizontalAlignment="Center" VerticalAlignment="Center" Width="520"
                    Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="26,24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Image Source="/Assets/Icons/Toolbox_16x.png" Width="20" Height="20" Margin="0,0,8,0" />
                        <TextBlock x:Name="EmptyTitle" Text="开始编写行为" FontSize="16" FontWeight="SemiBold" Foreground="#E8E8E8" />
                    </StackPanel>
                    <TextBlock x:Name="EmptyText" Text="从右侧积木库拖入事件积木。" FontSize="11.5" Foreground="#9A9A9A"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" LineHeight="19" />
                    <Rectangle Height="1" Fill="#3F3F46" Margin="30,16,30,14" />
                    <TextBlock Text="提示：事件积木（当生成时、每帧、每 N 帧…）是脚本的开头；行为积木按顺序执行。等待积木放在脚本顶层时，会延迟后续积木。"
                               FontSize="10" Foreground="#777777" TextWrapping="Wrap" TextAlignment="Center" LineHeight="17" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
