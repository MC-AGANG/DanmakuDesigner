<UserControl x:Class="EventPoint"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DanmakuDesigner"
             mc:Ignorable="d" 
             d:DesignHeight="16" d:DesignWidth="16"
             Loaded="UserControl_Loaded"
             MouseDown="UserControl_MouseDown">
    <Grid>
        <Label Padding="0,0,0,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Name="LB_Main"/>
        <Border Name="BD_Selection" BorderBrush="Cyan" BorderThickness="2" Visibility="Hidden"/>
    </Grid>
</UserControl>
