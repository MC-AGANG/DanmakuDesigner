<Window x:Class="BossTextureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Boss 贴图"
        Width="780" Height="540"
        MinWidth="660" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        Foreground="#E8E8E8"
        FontFamily="Microsoft YaHei UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
            <RowDefinition Height="52" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Text="选择贴图" FontSize="16" FontWeight="SemiBold"
                   VerticalAlignment="Center" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="可用图片资源" FontSize="11" Foreground="#9A9A9A" Margin="0,0,0,6" />
                <ListBox x:Name="AvailableList" SelectionMode="Extended" Background="#252526"
                         Foreground="#D4D4D4" BorderBrush="#3F3F46" DisplayMemberPath="Display" />
            </DockPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                <Button Content="→ 添加" Style="{StaticResource VS.Button}" Margin="0,0,0,8" Click="Add_Click" />
                <Button Content="← 移除" Style="{StaticResource VS.Button}" Margin="0,0,0,8" Click="Remove_Click" />
                <Button Content="上移" Style="{StaticResource VS.Button}" Margin="0,0,0,8" Click="Up_Click" />
                <Button Content="下移" Style="{StaticResource VS.Button}" Click="Down_Click" />
            </StackPanel>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="已选择的动画帧（从上到下播放）" FontSize="11" Foreground="#9A9A9A" Margin="0,0,0,6" />
                <ListBox x:Name="SelectedList" SelectionMode="Extended" Background="#252526"
                         Foreground="#D4D4D4" BorderBrush="#3F3F46" DisplayMemberPath="Display" />
            </DockPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="确定" Width="82" Height="30" Style="{StaticResource VS.AccentButton}" Click="Ok_Click" />
            <Button Content="取消" Width="82" Height="30" Margin="8,0,0,0" Style="{StaticResource VS.Button}" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
