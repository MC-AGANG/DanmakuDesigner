<UserControl x:Class="PropertyBoard_Bullet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DanmakuDesigner"
             mc:Ignorable="d" 
             d:DesignHeight="264" d:DesignWidth="256"
             Loaded="UserControl_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="16"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="1*" MinWidth="16"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="1*" MinWidth="16"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <GridSplitter Background="#FF2D2D30" Width="4" Grid.Column="1" ResizeBehavior="PreviousAndNext" Focusable="False"/>
        <GridSplitter Background="#FF2D2D30" Width="4" Grid.Column="3" ResizeBehavior="PreviousAndNext" Focusable="False"/>
        <Label Content="项目" Grid.Row="0" Foreground="White"/>
        <Label Content="出现时间" Grid.Row="1" Foreground="White"/>
        <Label Content="自机狙" Grid.Row="2" Foreground="White"/>
        <Label Content="外观" Grid.Row="3" Foreground="White"/>
        <Label Content="颜色" Grid.Row="4" Foreground="White"/>
        <Label Content="X坐标" Grid.Row="5" Foreground="White"/>
        <Label Content="Y坐标" Grid.Row="6" Foreground="White"/>
        <Label Name="LB_Speed" Content="速度" Grid.Row="7" Foreground="White"/>
        <Label Name="LB_Direction" Content="方向" Grid.Row="8" Foreground="White"/>
        <Label Content="可被消弹" Grid.Row="9" Foreground="White"/>
        <Label Content="标签" Grid.Row="10" Foreground="White"/>

        <Label Content="数值" Grid.Row="0" Grid.Column="2" Foreground="White"/>
        <TextBox Name="TB_Tick" Grid.Row="1" Grid.Column="2" LostKeyboardFocus="TB_Tick_LostKeyboardFocus"/>
        <CheckBox Name="CB_Sniper" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Checked="CB_Sniper_Checked" Unchecked="CB_Sniper_Unchecked"/>
        <ComboBox Name="CB_BulletType" Grid.Row="3" Grid.Column="2" SelectionChanged="CB_BulletType_SelectionChanged"/>
        <ComboBox Name="CB_BulletColor" Grid.Row="4" Grid.Column="2" SelectionChanged="CB_BulletColor_SelectionChanged"/>
        <TextBox Name="TB_X" Grid.Row="5" Grid.Column="2" LostKeyboardFocus="TB_X_LostKeyboardFocus"/>
        <TextBox Name="TB_Y" Grid.Row="6" Grid.Column="2" LostKeyboardFocus="TB_Y_LostKeyboardFocus"/>
        <TextBox Name="TB_Speed" Grid.Row="7" Grid.Column="2" LostKeyboardFocus="TB_Speed_LostKeyboardFocus"/>
        <TextBox Name="TB_Direction" Grid.Row="8" Grid.Column="2" LostKeyboardFocus="TB_Direction_LostKeyboardFocus"/>
        <CheckBox Name="CB_Breakable" Grid.Row="9" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Checked="CB_Breakable_Checked" Unchecked="CB_Breakable_Unchecked"/>
        <TextBox Name="TB_Tag" Grid.Row="10" Grid.Column="2" LostKeyboardFocus="TB_Tag_LostKeyboardFocus"/>

        <Label Content="随机量" Grid.Row="0" Grid.Column="4" Foreground="White"/>
        <TextBox Name="TB_X_Rand" Grid.Row="5" Grid.Column="4" LostKeyboardFocus="TB_X_Rand_LostKeyboardFocus"/>
        <TextBox Name="TB_Y_Rand" Grid.Row="6" Grid.Column="4" LostKeyboardFocus="TB_Y_Rand_LostKeyboardFocus"/>
        <TextBox Name="TB_Speed_Rand" Grid.Row="7" Grid.Column="4" LostKeyboardFocus="TB_Speed_Rand_LostKeyboardFocus"/>
        <TextBox Name="TB_Direction_Rand" Grid.Row="8" Grid.Column="4" LostKeyboardFocus="TB_Direction_Rand_LostKeyboardFocus"/>
    </Grid>
</UserControl>
