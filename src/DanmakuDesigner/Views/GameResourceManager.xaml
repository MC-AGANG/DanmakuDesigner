<UserControl x:Class="GameResourceManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="8,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="/Assets/Icons/Folder_16x.png" Width="16" Height="16" Margin="2,0,8,0" />
                <TextBlock Grid.Column="1" Text="游戏资源" FontSize="12" FontWeight="SemiBold" Foreground="#D0D0D0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ImportImageButton" Style="{StaticResource VS.ToolButton}" Click="ImportImage_Click" Height="30" ToolTip="导入图片资源">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/Icons/Media_16x.png" Width="16" Height="16" />
                            <TextBlock Text="图片" Margin="5,0,1,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ImportAudioButton" Style="{StaticResource VS.ToolButton}" Click="ImportAudio_Click" Height="30" ToolTip="导入音频资源">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/Icons/AudioPlayback_16x.png" Width="16" Height="16" />
                            <TextBlock Text="音频" Margin="5,0,1,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button Grid.Column="4" x:Name="OpenFolderButton" Style="{StaticResource VS.ToolButton}" Click="OpenFolder_Click" Height="30" ToolTip="打开资源目录">
                    <Image Source="/Assets/Icons/OpenFile_16x.png" Width="16" Height="16" />
                </Button>
                <Button Grid.Column="5" x:Name="RemoveButton" Style="{StaticResource VS.ToolButton}" Click="Remove_Click" Height="30" ToolTip="移除选中的资源">
                    <Image Source="/Assets/Icons/DeleteEvent_16x.png" Width="16" Height="16" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="220" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <Border Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,4,0,8">
                    <StackPanel x:Name="ListHost" />
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="#181818" />

            <Border Grid.Column="2" Background="#1E1E1E" Padding="18,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="资源预览" FontSize="12" FontWeight="SemiBold" Foreground="#D0D0D0" />
                        <TextBlock Text="资源会随游戏工程一起导出为独立资源包工程。" FontSize="10" Foreground="#7A7A7A" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border Grid.Row="1" Margin="0,14" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="2">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="Uniform" Margin="18" />
                            <TextBlock x:Name="PreviewPlaceholder" Text="选择左侧资源查看预览" FontSize="12" Foreground="#6F6F6F"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="2">
                        <TextBlock x:Name="ResourceNameText" Text="未选择资源" FontSize="14" FontWeight="SemiBold" Foreground="#E8E8E8" />
                        <TextBlock x:Name="ResourceKindText" Text="" FontSize="10.5" Foreground="#8A8A8A" Margin="0,3,0,8" />
                        <TextBlock x:Name="ResourcePathText" Text="" FontSize="10.5" Foreground="#9A9A9A" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="RenameButton" Content="重命名" Style="{StaticResource VS.Button}" Click="Rename_Click" Margin="0,0,8,0" />
                            <Button x:Name="OpenResourceButton" Content="打开文件" Style="{StaticResource VS.Button}" Click="OpenResource_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
