<UserControl x:Class="OutputPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#252526">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource VS.PanelHeaderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="/Assets/Icons/Output_16x.png" Width="16" Height="16" Margin="0,0,7,0" />
                <TextBlock Grid.Column="1" Text="输出" Style="{StaticResource VS.PanelTitle}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                    <Border x:Name="ErrorBadge" Background="#4A2020" CornerRadius="2" Padding="5,1" Margin="0,0,4,0">
                        <TextBlock x:Name="ErrorCountText" Text="0 错误" FontSize="9.5" Foreground="#F48771" />
                    </Border>
                    <Border x:Name="WarningBadge" Background="#403618" CornerRadius="2" Padding="5,1" Margin="0,0,4,0">
                        <TextBlock x:Name="WarningCountText" Text="0 警告" FontSize="9.5" Foreground="#DCDCAA" />
                    </Border>
                    <TextBlock x:Name="InfoCountText" Text="0 信息" FontSize="9.5" Foreground="#8A8A8A" VerticalAlignment="Center" Margin="3,0,0,0" />
                </StackPanel>
                <CheckBox Grid.Column="4" x:Name="ProblemsOnlyCheck" Content="仅问题" FontSize="10" VerticalAlignment="Center" Margin="0,0,10,0"
                          Checked="Filter_Changed" Unchecked="Filter_Changed" />
                <Button Grid.Column="5" Style="{StaticResource VS.IconButton}" Click="Validate_Click" ToolTip="重新验证工程" Width="24" Height="24">
                    <Image Source="/Assets/Icons/Refresh_16x.png" Width="14" Height="14" />
                </Button>
                <Button Grid.Column="6" Style="{StaticResource VS.IconButton}" Click="Clear_Click" ToolTip="清空输出" Width="24" Height="24">
                    <Image Source="/Assets/Icons/DeleteEvent_16x.png" Width="14" Height="14" />
                </Button>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" x:Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,3,0,4">
            <StackPanel x:Name="ListHost" />
        </ScrollViewer>
    </Grid>
</UserControl>
