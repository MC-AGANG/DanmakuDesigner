<UserControl x:Class="BlockPaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#252526">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource VS.PanelHeaderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="/Assets/Icons/Toolbox_16x.png" Width="16" Height="16" Margin="0,0,7,0" />
                <TextBlock Grid.Column="1" Text="积木库" Style="{StaticResource VS.PanelTitle}" />
                <TextBlock x:Name="ContextText" Grid.Column="2" Text="未选择行为" FontSize="9.5" Foreground="#8A8A8A" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#252526" Padding="8,5">
            <Grid>
                <TextBox x:Name="SearchBox" Height="25" Padding="22,2,4,2" FontSize="11" TextChanged="Search_Changed" />
                <TextBlock x:Name="SearchHint" Text="搜索积木..." FontSize="11" Foreground="#6F6F6F" Margin="25,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False" />
                <Image Source="/Assets/Icons/Search_16x.png" Width="13" Height="13" HorizontalAlignment="Left" Margin="5,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,4,8,10">
            <StackPanel x:Name="PaletteHost" />
        </ScrollViewer>

        <Border Grid.Row="3" Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="0,1,0,0" Padding="9,5">
            <TextBlock Text="拖动积木到画布，或单击追加到最后一个脚本。" FontSize="10" Foreground="#7A7A7A" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
