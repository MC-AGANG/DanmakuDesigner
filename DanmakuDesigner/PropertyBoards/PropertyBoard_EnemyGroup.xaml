<UserControl x:Class="PropertyBoard_EnemyGroup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DanmakuDesigner"
             xmlns:AGC="clr-namespace:AgControls;assembly=AgControls"
             mc:Ignorable="d" 
             d:DesignHeight="336" d:DesignWidth="256"
             Loaded="UserControl_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="16"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="1*" MinWidth="16"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="1*" MinWidth="16"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <GridSplitter Background="#FF2D2D30" Width="4" Grid.Column="1" ResizeBehavior="PreviousAndNext" Focusable="False"/>
        <GridSplitter Background="#FF2D2D30" Width="4" Grid.Column="3" ResizeBehavior="PreviousAndNext" Focusable="False"/>
        <Label Content="项目" Grid.Row="0" Foreground="White"/>
        <Label Content="出现时间" Grid.Row="1" Foreground="White"/>
        <Label Content="数量" Grid.Row="2" Foreground="White"/>
        <Label Content="外观" Grid.Row="3" Foreground="White"/>
        <Label Content="颜色" Grid.Row="4" Foreground="White"/>
        <Label Content="X坐标" Grid.Row="5" Foreground="White"/>
        <Label Content="Y坐标" Grid.Row="6" Foreground="White"/>
        <Label Content="血量" Grid.Row="7" Foreground="White"/>
        <Label Content="掉落物" Grid.Row="8" Foreground="White"/>
        <Label Content="寿命" Grid.Row="9" Foreground="White"/>
        <Label Content="速度" Grid.Row="10" Foreground="White"/>
        <Label Content="方向" Grid.Row="11" Foreground="White"/>
        <Label Content="防御值" Grid.Row="12" Foreground="White"/>
        <Label Content="标签" Grid.Row="13" Foreground="White"/>

        <Label Content="起始数值" Grid.Row="0" Grid.Column="2" Foreground="White"/>
        <TextBox Name="TB_Tick" Grid.Row="1" Grid.Column="2" LostKeyboardFocus="TB_Tick_LostKeyboardFocus"/>
        <TextBox Name="TB_Count" Grid.Row="2" Grid.Column="2" LostKeyboardFocus="TB_Count_LostKeyboardFocus"/>
        <ComboBox Name="CB_EnemyType" Grid.Row="3" Grid.Column="2" SelectionChanged="CB_EnemyType_SelectionChanged"/>
        <ComboBox Name="CB_EnemyColor" Grid.Row="4" Grid.Column="2" SelectionChanged="CB_EnemyColor_SelectionChanged"/>
        <TextBox Name="TB_X" Grid.Row="5" Grid.Column="2" LostKeyboardFocus="TB_X_LostKeyboardFocus"/>
        <TextBox Name="TB_Y" Grid.Row="6" Grid.Column="2" LostKeyboardFocus="TB_Y_LostKeyboardFocus"/>
        <TextBox Name="TB_HP" Grid.Row="7" Grid.Column="2" LostKeyboardFocus="TB_HP_LostKeyboardFocus"/>
        <AGC:Button Name="BT_Item" Grid.Row="8" Grid.Column="2" Text="编辑..." Width="64" HorizontalAlignment="Left" Clicked="BT_Item_Clicked"/>
        <TextBox Name="TB_Life" Grid.Row="9" Grid.Column="2" LostKeyboardFocus="TB_Life_LostKeyboardFocus"/>
        <TextBox Name="TB_Speed" Grid.Row="10" Grid.Column="2" LostKeyboardFocus="TB_Speed_LostKeyboardFocus"/>
        <TextBox Name="TB_Direction" Grid.Row="11" Grid.Column="2" LostKeyboardFocus="TB_Direction_LostKeyboardFocus"/>
        <TextBox Name="TB_Defence" Grid.Row="12" Grid.Column="2" LostKeyboardFocus="TB_Defence_LostKeyboardFocus"/>
        <TextBox Name="TB_Tag" Grid.Row="13" Grid.Column="2" LostKeyboardFocus="TB_Tag_LostKeyboardFocus"/>

        <Label Content="终止数值" Grid.Row="0" Grid.Column="4" Foreground="White"/>
        <TextBox Name="TB_X_End" Grid.Row="5" Grid.Column="4" LostKeyboardFocus="TB_X_End_LostKeyboardFocus"/>
        <TextBox Name="TB_Y_End" Grid.Row="6" Grid.Column="4" LostKeyboardFocus="TB_Y_End_LostKeyboardFocus"/>
        <TextBox Name="TB_Speed_End" Grid.Row="10" Grid.Column="4" LostKeyboardFocus="TB_Speed_End_LostKeyboardFocus"/>
        <TextBox Name="TB_Direction_End" Grid.Row="11" Grid.Column="4" LostKeyboardFocus="TB_Direction_End_LostKeyboardFocus"/>
    </Grid>
</UserControl>
