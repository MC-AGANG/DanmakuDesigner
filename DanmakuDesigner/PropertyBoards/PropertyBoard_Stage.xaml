<UserControl x:Class="PropertyBoard_Stage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DanmakuDesigner"
             mc:Ignorable="d" 
             d:DesignHeight="48" d:DesignWidth="256">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="16"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="1*" MinWidth="16"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="1*" MinWidth="16"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <GridSplitter Background="#FF2D2D30" Width="4" Grid.Column="1" ResizeBehavior="PreviousAndNext" Focusable="False"/>
        <GridSplitter Background="#FF2D2D30" Width="4" Grid.Column="3" ResizeBehavior="PreviousAndNext" Focusable="False"/>
        <Label Content="项目" Grid.Row="0" Foreground="White"/>
        <Label Content="关卡长度" Grid.Row="1" Foreground="White"/>
        
        <Label Content="数值" Grid.Row="0" Grid.Column="2" Foreground="White"/>
        <TextBox Name="TB_Length" Grid.Row="1" Grid.Column="2" LostKeyboardFocus="TB_Length_LostKeyboardFocus"/>
    </Grid>
</UserControl>
