<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>DanmakuDesigner</RootNamespace>
    <AssemblyName>DanmakuDesigner</AssemblyName>
    <UseWPF>true</UseWPF>
    <OptionExplicit>On</OptionExplicit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <NeutralLanguage>zh-CN</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Windows" />
    <Import Include="System.Windows.Controls" />
    <Import Include="System.Windows.Data" />
    <Import Include="System.Windows.Documents" />
    <Import Include="System.Windows.Input" />
    <Import Include="System.Windows.Media" />
    <Import Include="System.Windows.Media.Imaging" />
    <Import Include="System.Windows.Navigation" />
    <Import Include="System.Windows.Shapes" />
    <Import Include="DanmakuDesigner.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DanmakuDesigner.Core\DanmakuDesigner.Core.vbproj" />
    <ProjectReference Include="..\..\..\AgSTG\AgSTG\AgSTG.vbproj" />
    <ProjectReference Include="..\..\..\AgSTG\ResourcePack\ResourcePack.vbproj" />
    <ProjectReference Include="..\..\..\AgSTG\ResourcePack.TH07\ResourcePack.TH07.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ManagedBass">
      <HintPath>..\..\..\AgSTG\dll\Bass\ManagedBass.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>Lib\Roslyn\Microsoft.CodeAnalysis.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.VisualBasic">
      <HintPath>Lib\Roslyn\Microsoft.CodeAnalysis.VisualBasic.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\AgSTG\dll\Bass\bass.dll" Link="bass.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Icons\*.png" />
    <Resource Include="Assets\Window\*.png" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="logo.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="EngineTemplate.zip">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\samples\DemoStage.dmkproj" Link="Samples\DemoStage.dmkproj">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="logo.png" />
  </ItemGroup>

  <ItemGroup>
    <None Update="app.manifest">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
