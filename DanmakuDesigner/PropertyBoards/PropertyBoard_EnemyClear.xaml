<UserControl x:Class="PropertyBoard_EnemyClear"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DanmakuDesigner"
             mc:Ignorable="d" 
             d:DesignHeight="72" d:DesignWidth="256">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="16"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="1*" MinWidth="16"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="1*" MinWidth="16"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <GridSplitter Background="#FF2D2D30" Width="4" Grid.Column="1" ResizeBehavior="PreviousAndNext" Focusable="False"/>
        <GridSplitter Background="#FF2D2D30" Width="4" Grid.Column="3" ResizeBehavior="PreviousAndNext" Focusable="False"/>
        <Label Content="项目" Grid.Row="0" Foreground="White"/>
        <Label Content="执行时间" Grid.Row="1" Foreground="White"/>
        <CheckBox Name="CB_Tag" Content="匹配Tag" Grid.Row="2" Foreground="White" Checked="CB_Tag_Checked" Unchecked="CB_Tag_Unchecked" Margin="0,4,0,0"/>

        <Label Content="数值" Grid.Row="0" Grid.Column="2" Foreground="White"/>
        <TextBox Name="TB_Tick" Grid.Row="1" Grid.Column="2" LostKeyboardFocus="TB_Tick_LostKeyboardFocus"/>
        <TextBox Name="TB_Tag" Grid.Row="2" Grid.Column="2" LostKeyboardFocus="TB_Tag_LostKeyboardFocus"/>
    </Grid>
</UserControl>
