<UserControl x:Class="CodePreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <Border Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="/Assets/Icons/VBFile_16x.png" Width="16" Height="16" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="生成的 VB 代码" FontSize="12" FontWeight="SemiBold" Foreground="#E8E8E8" VerticalAlignment="Center" />
                <ComboBox Grid.Column="2" x:Name="FileCombo" Width="220" Height="26" Margin="16,0,0,0" SelectionChanged="File_Changed">
                    <ComboBoxItem Content="StageXxx.vb · 关卡逻辑" Tag="stage" />
                    <ComboBoxItem Content="StageXxxbg.xaml · 背景" Tag="bgxaml" />
                    <ComboBoxItem Content="StageXxxbg.xaml.vb · 背景代码" Tag="bgcode" />
                    <ComboBoxItem Content="StageXxx.vbproj · 工程文件" Tag="project" />
                    <ComboBoxItem Content="导出入门 · 集成说明" Tag="integration" />
                </ComboBox>
                <Button Grid.Column="4" Style="{StaticResource VS.ToolButton}" Click="Refresh_Click" Height="28" Margin="0,0,4,0" ToolTip="重新生成代码">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/Icons/Refresh_16x.png" Width="14" Height="14" />
                        <TextBlock Text="刷新" Margin="5,0,0,0" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="5" Style="{StaticResource VS.ToolButton}" Click="Copy_Click" Height="28" Margin="0,0,4,0" ToolTip="复制当前文件">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/Icons/Copy_16x.png" Width="14" Height="14" />
                        <TextBlock Text="复制" Margin="5,0,0,0" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="6" Style="{StaticResource VS.AccentButton}" Click="Export_Click" Height="26" Padding="12,2">
                    导出工程
                </Button>
            </Grid>
        </Border>

        <RichTextBox Grid.Row="1" x:Name="CodeBox" Background="#1E1E1E" Foreground="#D4D4D4" BorderThickness="0"
                     FontFamily="Consolas" FontSize="12.5" IsReadOnly="True" IsDocumentEnabled="False"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Padding="4,6,10,20" SelectionBrush="#264F78" CaretBrush="#FFFFFF" />
        <Border Grid.Row="2" Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,1,0,0" Padding="10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="尚未生成" FontSize="10" Foreground="#8A8A8A" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" x:Name="ClassText" Text="" FontSize="10" Foreground="#6F6F6F" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
