<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ===================== Visual Studio Dark palette ===================== -->
    <SolidColorBrush x:Key="VS.Window" Color="#1E1E1E" />
    <SolidColorBrush x:Key="VS.Panel" Color="#252526" />
    <SolidColorBrush x:Key="VS.PanelAlt" Color="#2A2A2B" />
    <SolidColorBrush x:Key="VS.PanelHeader" Color="#2D2D30" />
    <SolidColorBrush x:Key="VS.Toolbar" Color="#2D2D30" />
    <SolidColorBrush x:Key="VS.Menu" Color="#2D2D30" />
    <SolidColorBrush x:Key="VS.Border" Color="#3F3F46" />
    <SolidColorBrush x:Key="VS.BorderSoft" Color="#333337" />
    <SolidColorBrush x:Key="VS.Hover" Color="#3E3E42" />
    <SolidColorBrush x:Key="VS.HoverSoft" Color="#2D2D30" />
    <SolidColorBrush x:Key="VS.Selection" Color="#264F78" />
    <SolidColorBrush x:Key="VS.SelectionSoft" Color="#094771" />
    <SolidColorBrush x:Key="VS.Accent" Color="#007ACC" />
    <SolidColorBrush x:Key="VS.AccentHover" Color="#1C97EA" />
    <SolidColorBrush x:Key="VS.Status" Color="#007ACC" />
    <SolidColorBrush x:Key="VS.Text" Color="#F1F1F1" />
    <SolidColorBrush x:Key="VS.TextSoft" Color="#CCCCCC" />
    <SolidColorBrush x:Key="VS.TextMuted" Color="#9A9A9A" />
    <SolidColorBrush x:Key="VS.TextDisabled" Color="#656565" />
    <SolidColorBrush x:Key="VS.Error" Color="#F14C4C" />
    <SolidColorBrush x:Key="VS.Warning" Color="#CCA700" />
    <SolidColorBrush x:Key="VS.Info" Color="#75BEFF" />
    <SolidColorBrush x:Key="VS.Success" Color="#89D185" />
    <SolidColorBrush x:Key="VS.Playhead" Color="#F14C4C" />
    <SolidColorBrush x:Key="VS.Grid" Color="#2A2A2A" />
    <SolidColorBrush x:Key="VS.GridStrong" Color="#333333" />

    <!-- 显式使用中文字体，避免 Segoe UI 在 CJK 回退时选中日文字体。 -->
    <FontFamily x:Key="VS.Font">Microsoft YaHei UI, Microsoft YaHei</FontFamily>
    <FontFamily x:Key="VS.Mono">Consolas</FontFamily>

    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource VS.Window}" />
        <Setter Property="Foreground" Value="{StaticResource VS.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource VS.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource VS.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource VS.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource VS.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource VS.Font}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ===================== Menu ===================== -->
    <Style TargetType="Menu">
        <Setter Property="Background" Value="{StaticResource VS.Menu}" />
        <Setter Property="Foreground" Value="{StaticResource VS.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource VS.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="4,0" />
    </Style>

    <Style x:Key="VS.TopMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource VS.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="2">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </Border>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Bottom"
                               PopupAnimation="Fade" StaysOpen="False">
                            <Border Background="#1B1B1C" BorderBrush="#454548" BorderThickness="1"
                                    CornerRadius="3" Padding="4" MinWidth="228" Margin="0,1,8,8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" Opacity="0.45" ShadowDepth="2" Color="#000000" />
                                </Border.Effect>
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource VS.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource VS.Hover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource VS.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="2" Padding="6,4" Margin="0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path x:Name="Check" Data="M0,4 L3.2,7.2 L9.5,0.8" Stroke="{StaticResource VS.Text}"
                                  StrokeThickness="1.6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="Collapsed" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                              VerticalAlignment="Center" Margin="2,0,12,0" />
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                       Foreground="{StaticResource VS.TextMuted}" VerticalAlignment="Center" Margin="18,0,6,0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource VS.SelectionSoft}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource VS.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="6,4" />
        <Setter Property="Background" Value="{StaticResource VS.Border}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{StaticResource VS.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource VS.Font}" />
        <Setter Property="Background" Value="#1B1B1C" />
        <Setter Property="BorderBrush" Value="#454548" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="3" Padding="4" MinWidth="190">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Opacity="0.4" ShadowDepth="2" Color="#000000" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Buttons ===================== -->
    <Style x:Key="VS.ToolButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource VS.Text}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource VS.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#4A4A4F" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VS.IconButton" TargetType="Button" BasedOn="{StaticResource VS.ToolButton}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="VS.Button" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource VS.Text}" />
        <Setter Property="Background" Value="#3A3D41" />
        <Setter Property="BorderBrush" Value="#4A4D51" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="11,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#4A4D51" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#5A5D61" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VS.AccentButton" TargetType="Button" BasedOn="{StaticResource VS.Button}">
        <Setter Property="Background" Value="{StaticResource VS.Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource VS.Accent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="13,5" />
    </Style>

    <Style x:Key="VS.LinkButton" TargetType="Button" BasedOn="{StaticResource VS.ToolButton}">
        <Setter Property="Foreground" Value="{StaticResource VS.Info}" />
        <Setter Property="Padding" Value="3,2" />
    </Style>

    <!-- ===================== TextBox ===================== -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#1B1B1C" />
        <Setter Property="Foreground" Value="{StaticResource VS.Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource VS.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="CaretBrush" Value="#FFFFFF" />
        <Setter Property="SelectionBrush" Value="{StaticResource VS.Selection}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="{StaticResource VS.Font}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource VS.Accent}" />
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
                <Setter Property="Background" Value="#252526" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource VS.TextDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== ComboBox ===================== -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource VS.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="7,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="2">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource VS.SelectionSoft}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource VS.Selection}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource VS.Text}" />
        <Setter Property="Background" Value="#1B1B1C" />
        <Setter Property="BorderBrush" Value="{StaticResource VS.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="5,3" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MaxDropDownHeight" Value="320" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" Margin="1,0,0,0" />
                                            <Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="{StaticResource VS.TextSoft}"
                                                  StrokeThickness="1.2" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#5A5A5F" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom" PopupAnimation="Fade" MinWidth="{TemplateBinding ActualWidth}">
                            <Border Background="#1B1B1C" BorderBrush="#454548" BorderThickness="1" CornerRadius="2"
                                    MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,1,6,6">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" Opacity="0.4" ShadowDepth="2" Color="#000000" />
                                </Border.Effect>
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" VerticalScrollBarVisibility="Auto">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" Margin="3" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource VS.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== CheckBox ===================== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource VS.TextSoft}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="14" Height="14" Background="#1B1B1C" BorderBrush="#6D6D6D"
                                BorderThickness="1" CornerRadius="2" VerticalAlignment="Center">
                            <Path x:Name="Check" Data="M1,5 L4.5,8.5 L11,1.5" Stroke="#FFFFFF" StrokeThickness="1.7"
                                  Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource VS.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource VS.Accent}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="#9A9A9A" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource VS.TextSoft}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="14" Height="14" Background="#1B1B1C" BorderBrush="#6D6D6D"
                                BorderThickness="1" CornerRadius="7" VerticalAlignment="Center">
                            <Ellipse x:Name="Dot" Width="6" Height="6" Fill="#FFFFFF" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource VS.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource VS.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== ScrollBar ===================== -->
    <Style x:Key="VS.ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" Background="#5A5A5A" CornerRadius="5" Margin="2" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#8A8A8A" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#A0A0A0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="#1E1E1E" />
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource VS.ScrollThumb}" MinHeight="24" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="12" />
                <Setter Property="MinHeight" Value="12" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ===================== ToolTip / GridSplitter ===================== -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#252526" />
        <Setter Property="Foreground" Value="{StaticResource VS.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource VS.Font}" />
        <Setter Property="BorderBrush" Value="#505054" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HasDropShadow" Value="True" />
    </Style>

    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="#1E1E1E" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ShowsPreview" Value="False" />
    </Style>

    <!-- ===================== Panels / tabs ===================== -->
    <Style x:Key="VS.PanelCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource VS.Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource VS.BorderSoft}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="VS.PanelHeaderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource VS.PanelHeader}" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="9,0,5,0" />
        <Setter Property="BorderBrush" Value="{StaticResource VS.BorderSoft}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style x:Key="VS.PanelTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource VS.TextSoft}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="VS.DocTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource VS.TextMuted}" />
        <Setter Property="Background" Value="#2D2D30" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource VS.BorderSoft}"
                            BorderThickness="0,0,1,0" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <Border x:Name="Accent" Height="2" VerticalAlignment="Top" Background="Transparent" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#323235" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource VS.Window}" />
                            <Setter TargetName="Accent" Property="Background" Value="{StaticResource VS.Accent}" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VS.StatusText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="VS.FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource VS.TextMuted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===================== Block editing fields ===================== -->
    <Style x:Key="BlockFieldTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="#F4F6F8" />
        <Setter Property="Foreground" Value="#0B1220" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="2,0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Height" Value="20" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="TextAlignment" Value="Center" />
