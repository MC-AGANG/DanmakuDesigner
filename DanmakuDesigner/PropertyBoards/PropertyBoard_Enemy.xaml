<UserControl x:Class="PropertyBoard_Enemy"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DanmakuDesigner"
             xmlns:AGC="clr-namespace:AgControls;assembly=AgControls"
             mc:Ignorable="d" 
             d:DesignHeight="312" d:DesignWidth="256"
             Loaded="UserControl_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="16"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="1*" MinWidth="16"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <GridSplitter Background="#FF2D2D30" Width="5" Grid.Column="1" ResizeBehavior="PreviousAndNext" Focusable="False"/>
        <Label Content="项目" Grid.Row="0" Foreground="White"/>
        <Label Content="出现时间" Grid.Row="1" Foreground="White"/>
        <Label Content="外观" Grid.Row="2" Foreground="White"/>
        <Label Content="颜色" Grid.Row="3" Foreground="White"/>
        <Label Content="X坐标" Grid.Row="4" Foreground="White"/>
        <Label Content="Y坐标" Grid.Row="5" Foreground="White"/>
        <Label Content="血量" Grid.Row="6" Foreground="White"/>
        <Label Content="掉落物" Grid.Row="7" Foreground="White"/>
        <Label Content="寿命" Grid.Row="8" Foreground="White"/>
        <Label Content="速度" Grid.Row="9" Foreground="White"/>
        <Label Content="方向" Grid.Row="10" Foreground="White"/>
        <Label Content="防御值" Grid.Row="11" Foreground="White"/>
        <Label Content="标签" Grid.Row="12" Foreground="White"/>

        <Label Content="数值" Grid.Row="0" Grid.Column="2" Foreground="White"/>
        <TextBox Name="TB_Tick" Grid.Row="1" Grid.Column="2" Foreground="White" Background="#FF1F1F1F" BorderBrush="#FF424242" SelectionBrush="#FF353535" TextChanged="TB_Tick_TextChanged"/>
        <ComboBox Name="CB_EnemyType" Grid.Row="2" Grid.Column="2" SelectionChanged="CB_EnemyType_SelectionChanged"/>
        <ComboBox Name="CB_EnemyColor" Grid.Row="3" Grid.Column="2" SelectionChanged="CB_EnemyColor_SelectionChanged"/>
        <TextBox Name="TB_X" Grid.Row="4" Grid.Column="2" Foreground="White" Background="#FF1F1F1F" BorderBrush="#FF424242" SelectionBrush="#FF353535" TextChanged="TB_X_TextChanged"/>
        <TextBox Name="TB_Y" Grid.Row="5" Grid.Column="2" Foreground="White" Background="#FF1F1F1F" BorderBrush="#FF424242" SelectionBrush="#FF353535" TextChanged="TB_Y_TextChanged"/>
        <TextBox Name="TB_HP" Grid.Row="6" Grid.Column="2" Foreground="White" Background="#FF1F1F1F" BorderBrush="#FF424242" SelectionBrush="#FF353535" TextChanged="TB_HP_TextChanged"/>
        <AGC:Button Name="BT_Item" Grid.Row="7" Grid.Column="2" Text="编辑..." Width="64" HorizontalAlignment="Left" Clicked="BT_Item_Clicked"/>
        <TextBox Name="TB_Life" Grid.Row="8" Grid.Column="2" Foreground="White" Background="#FF1F1F1F" BorderBrush="#FF424242" SelectionBrush="#FF353535" TextChanged="TB_Life_TextChanged"/>
        <TextBox Name="TB_Speed" Grid.Row="9" Grid.Column="2" Foreground="White" Background="#FF1F1F1F" BorderBrush="#FF424242" SelectionBrush="#FF353535" TextChanged="TB_Speed_TextChanged"/>
        <TextBox Name="TB_Direction" Grid.Row="10" Grid.Column="2" Foreground="White" Background="#FF1F1F1F" BorderBrush="#FF424242" SelectionBrush="#FF353535" TextChanged="TB_Direction_TextChanged"/>
        <TextBox Name="TB_Defence" Grid.Row="11" Grid.Column="2" Foreground="White" Background="#FF1F1F1F" BorderBrush="#FF424242" SelectionBrush="#FF353535" TextChanged="TB_Defence_TextChanged"/>
        <TextBox Name="TB_Tag" Grid.Row="12" Grid.Column="2" Foreground="White" Background="#FF1F1F1F" BorderBrush="#FF424242" SelectionBrush="#FF353535" TextChanged="TB_Tag_TextChanged"/>
    </Grid>
</UserControl>
