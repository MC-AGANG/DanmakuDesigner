<Window x:Class="DialogueEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="对话编辑器"
        Width="980" Height="700"
        MinWidth="820" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        Foreground="#E8E8E8"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="名称" VerticalAlignment="Center" Foreground="#BDBDBD" Margin="0,0,10,0" />
            <TextBox x:Name="NameBox" Grid.Column="1" Height="28" VerticalContentAlignment="Center"
                     Background="#252526" Foreground="#E8E8E8" BorderBrush="#3F3F46" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                <Button Content="导入 CSV…" Style="{StaticResource VS.Button}" Margin="0,0,8,0" Click="ImportCsv_Click" />
                <Button Content="导出 CSV…" Style="{StaticResource VS.Button}" Click="ExportCsv_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="对话行" FontSize="11" Foreground="#9A9A9A" Margin="0,0,0,6" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="＋ 添加" Style="{StaticResource VS.Button}" Width="72" Click="AddLine_Click" />
                    <Button Content="移除" Style="{StaticResource VS.Button}" Width="60" Margin="6,0,0,0" Click="RemoveLine_Click" />
                    <Button Content="上移" Style="{StaticResource VS.Button}" Width="52" Margin="6,0,0,0" Click="UpLine_Click" />
                    <Button Content="下移" Style="{StaticResource VS.Button}" Width="52" Margin="6,0,0,0" Click="DownLine_Click" />
                </StackPanel>
                <ListBox x:Name="LinesList" Background="#252526" Foreground="#D4D4D4" BorderBrush="#3F3F46"
                         DisplayMemberPath="Display" SelectionChanged="LinesList_SelectionChanged" />
            </DockPanel>

            <Border Grid.Column="2" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="说话者" VerticalAlignment="Center" Foreground="#BDBDBD" />
                        <ComboBox x:Name="SpeakerBox" Grid.Column="1" Height="28" DisplayMemberPath="Display"
                                  SelectedValuePath="Id" SelectionChanged="SpeakerBox_SelectionChanged" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="立绘索引" VerticalAlignment="Center" Foreground="#BDBDBD" />
                        <TextBox x:Name="IllustrationBox" Grid.Column="1" Height="26" Text="0" TextChanged="Field_TextChanged" />
                        <TextBlock Grid.Column="2" Text="等待 CD" VerticalAlignment="Center" Foreground="#BDBDBD" Margin="14,0,8,0" />
                        <TextBox x:Name="CdBox" Grid.Column="3" Height="26" Text="15" TextChanged="Field_TextChanged" />
                        <CheckBox x:Name="AutoBox" Grid.Column="4" Content="CD 后自动下一句" VerticalAlignment="Center" Margin="16,0,0,0" Click="Field_Changed" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="对话内容（换行会转换为 &lt;br/&gt;）" Foreground="#BDBDBD" Margin="0,0,0,6" />
                        <TextBox x:Name="ContentBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" TextChanged="Field_TextChanged"
                                 Background="#1E1E1E" Foreground="#E8E8E8" BorderBrush="#3F3F46" Padding="6" />
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="结束后" VerticalAlignment="Center" Foreground="#BDBDBD" />
                        <ComboBox x:Name="AfterBox" Grid.Column="1" Height="28" DisplayMemberPath="Display"
                                  SelectedValuePath="Id" SelectionChanged="AfterBox_SelectionChanged" />
                    </Grid>

                    <Grid Grid.Row="4" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Boss 模板" VerticalAlignment="Center" Foreground="#BDBDBD" />
                        <ComboBox x:Name="BossBox" Grid.Column="1" Height="28" DisplayMemberPath="Display"
                                  SelectedValuePath="Id" />
                    </Grid>

                    <TextBlock Grid.Row="5" Margin="0,10,0,0" FontSize="10.5" Foreground="#8A8A8A"
                               Text="CSV 格式：player/enemy 元数据 → speaker,content,illustration,cd,auto。立绘索引目前对应空白占位图，可先只使用文本对话。" />
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确定" Width="82" Height="30" Style="{StaticResource VS.AccentButton}" Click="Ok_Click" />
            <Button Content="取消" Width="82" Height="30" Margin="8,0,0,0" Style="{StaticResource VS.Button}" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
