<UserControl x:Class="ProjectExplorer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#252526">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource VS.PanelHeaderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="/Assets/Icons/Folder_16x.png" Width="16" Height="16" Margin="0,0,7,0" />
                <TextBlock Grid.Column="1" Text="关卡资源管理器" Style="{StaticResource VS.PanelTitle}" />
                <Button Grid.Column="2" Style="{StaticResource VS.ToolButton}" Click="AddTemplate_Click" ToolTip="新建敌机模板" Height="24" Padding="4,0">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/Icons/Bug_16x.png" Width="14" Height="14" />
                        <TextBlock Text="＋" FontSize="11" Margin="2,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource VS.ToolButton}" Click="AddPattern_Click" ToolTip="新建子弹样式" Height="24" Padding="4,0">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/Icons/Bullet_16x.png" Width="14" Height="14" />
                        <TextBlock Text="＋" FontSize="11" Margin="2,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,4,0,10">
            <StackPanel x:Name="ListHost" />
        </ScrollViewer>

        <Border Grid.Row="2" Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="0,1,0,0" Padding="9,5">
            <TextBlock Text="双击敌机 / 子弹样式编辑积木行为" FontSize="10" Foreground="#7A7A7A" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
