<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DanmakuDesigner"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="DanmakuDesigner" Width="1500" Height="920" MinWidth="1120" MinHeight="700"
        Icon="/logo.png"
        WindowStartupLocation="CenterScreen" WindowStyle="None" Background="Transparent"
        AllowsTransparency="True" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Activated="Window_Activated" Deactivated="Window_Deactivated"
        SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing" StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="10" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <local:AccentGlowDecorator x:Name="AccentGlow" GlowSize="10" AccentColor="#FF68217A">
        <Border BorderThickness="0" Background="#1E1E1E">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="0" />
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="23" />
                </Grid.RowDefinitions>

                <!-- ================= 标题栏 ================= -->
                <Border Grid.Row="0" Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="9,0,0,0" VerticalAlignment="Center">
                            <Image x:Name="TitleIconImage" Source="/Assets/Icons/logo_w.png" Width="24" Height="24" Margin="0,0,8,0" />
                            <Menu Grid.Row="1" Background="#2D2D30" Padding="4,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                <MenuItem Header="文件(F)" Style="{StaticResource VS.TopMenuItem}">
                                    <MenuItem Header="新建工程" InputGestureText="Ctrl+N" Click="New_Click" />
                                    <MenuItem Header="打开工程…" InputGestureText="Ctrl+O" Click="Open_Click" />
                                    <Separator />
                                    <MenuItem x:Name="SaveMenuItem" Header="保存" InputGestureText="Ctrl+S" Click="Save_Click" />
                                    <MenuItem x:Name="SaveAsMenuItem" Header="另存为…" InputGestureText="Ctrl+Shift+S" Click="SaveAs_Click" />
                                    <Separator />
                                    <MenuItem x:Name="ExportMenuItem" Header="导出解决方案…" InputGestureText="Ctrl+E" Click="Export_Click" />
                                    <Separator />
                                    <MenuItem x:Name="CloseProjectMenuItem" Header="关闭项目" Click="CloseProject_Click" />
                                    <Separator />
                                    <MenuItem Header="退出" InputGestureText="Alt+F4" Click="Exit_Click" />
                                </MenuItem>
                                <MenuItem Header="编辑(E)" Style="{StaticResource VS.TopMenuItem}">
                                    <MenuItem x:Name="UndoMenu" Header="撤销" InputGestureText="Ctrl+Z" Click="Undo_Click" />
                                    <MenuItem x:Name="RedoMenu" Header="重做" InputGestureText="Ctrl+Y" Click="Redo_Click" />
                                    <Separator />
                                    <MenuItem Header="删除选中片段 / 积木" InputGestureText="Delete" Click="Delete_Click" />
                                    <MenuItem Header="复制片段 / 积木" InputGestureText="Ctrl+D" Click="Duplicate_Click" />
                                </MenuItem>
                                <MenuItem Header="视图(V)" Style="{StaticResource VS.TopMenuItem}">
                                    <MenuItem Header="时间轴" InputGestureText="Ctrl+1" Click="ViewTimeline_Click" />
                                    <MenuItem Header="积木编程" InputGestureText="Ctrl+2" Click="ViewBlocks_Click" />
                                    <MenuItem Header="试玩预览" InputGestureText="Ctrl+3" Click="ViewPreview_Click" />
                                    <MenuItem Header="代码预览" InputGestureText="Ctrl+4" Click="ViewCode_Click" />
                                    <MenuItem Header="游戏资源管理器" InputGestureText="Ctrl+5" Click="ViewResources_Click" />
                                    <MenuItem Header="背景编辑" InputGestureText="Ctrl+6" Click="ViewBackground_Click" />
                                    <Separator />
                                    <MenuItem x:Name="OutputMenu" Header="输出面板" IsCheckable="True" IsChecked="True" Click="ToggleOutput_Click" />
                                    <MenuItem Header="重置面板布局" Click="ResetLayout_Click" />
                                </MenuItem>
                                <MenuItem Header="关卡(S)" Style="{StaticResource VS.TopMenuItem}">
                                    <MenuItem Header="添加关卡…" Click="AddStage_Click" />
                                    <MenuItem Header="添加敌机模板" Click="AddTemplate_Click" />
                                    <MenuItem Header="添加子弹样式" Click="AddPattern_Click" />
                                    <MenuItem Header="添加轨道…" Click="AddTrack_Click" />
                                    <Separator />
                                    <MenuItem Header="重新验证工程" InputGestureText="F7" Click="Validate_Click" />
                                    <MenuItem Header="重置预览" Click="ResetPreview_Click" />
                                </MenuItem>
                                <MenuItem Header="运行(R)" Style="{StaticResource VS.TopMenuItem}">
                                    <MenuItem Header="播放 / 暂停预览" InputGestureText="F5" Click="PlayPause_Click" />
                                    <MenuItem Header="从头播放" InputGestureText="F6" Click="RestartPreview_Click" />
                                    <MenuItem Header="停止并回到开头" InputGestureText="Shift+F5" Click="StopPreview_Click" />
                                </MenuItem>
                                <MenuItem Header="帮助(H)" Style="{StaticResource VS.TopMenuItem}">
                                    <MenuItem Header="快捷键与操作说明" Click="Help_Click" />
                                    <MenuItem Header="关于 DanmakuDesigner" Click="About_Click" />
                                </MenuItem>
                            </Menu>



                            <Border Name="BD_Title" Background="#3A3A3D" CornerRadius="2" Padding="5,1" Margin="0,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="DocumentText" Text="&#26410;&#25171;&#24320;&#39033;&#30446;" FontSize="12" Foreground="#C8C8C8" VerticalAlignment="Center" />
                                    <TextBlock x:Name="DirtyText" Text="&#9679;" FontSize="12" Foreground="#E2C08D" Margin="5,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button x:Name="MinButton" Style="{StaticResource VS.IconButton}" Click="Minimize_Click" Width="44" Height="32" ToolTip="&#26368;&#23567;&#21270;">
                                <Image Source="/Assets/Window/minimize.png" Width="16" Height="16" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Button>
                            <Button x:Name="MaxButton" Style="{StaticResource VS.IconButton}" Click="Maximize_Click" Width="44" Height="32" ToolTip="&#26368;&#22823;&#21270; / &#36824;&#21407;">
                                <Image x:Name="MaxIcon" Source="/Assets/Window/maximize.png" Width="16" Height="16" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Button>
                            <Button x:Name="CloseButton" Style="{StaticResource VS.IconButton}" Click="Close_Click" Width="44" Height="32" ToolTip="&#20851;&#38381;">
                                <Image Source="/Assets/Window/close.png" Width="16" Height="16" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ================= 菜单栏 ================= -->

                <Border Grid.Row="2" Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                            <Button Style="{StaticResource VS.ToolButton}" Click="New_Click" Height="32" ToolTip="新建工程 (Ctrl+N)">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Assets/Icons/NewFile_16x.png" Width="16" Height="16" />
                                    <TextBlock Text="新建" Margin="5,0,1,0" VerticalAlignment="Center" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource VS.ToolButton}" Click="Open_Click" Height="32" ToolTip="打开工程 (Ctrl+O)">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Assets/Icons/OpenFile_16x.png" Width="16" Height="16" />
                                    <TextBlock Text="打开" Margin="5,0,1,0" VerticalAlignment="Center" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SaveButton" Style="{StaticResource VS.ToolButton}" Click="Save_Click" Height="32" ToolTip="保存 (Ctrl+S)">
                                <Image Source="/Assets/Icons/Save_16x.png" Width="16" Height="16" />
                            </Button>
                            <Button x:Name="SaveAsButton" Style="{StaticResource VS.ToolButton}" Click="SaveAs_Click" Height="32" ToolTip="全部保存 / 另存为">
                                <Image Source="/Assets/Icons/SaveAll_16x.png" Width="16" Height="16" />
                            </Button>
                            <Border Background="#464649" Width="1" Margin="7,8,7,8" />
                            <Button x:Name="UndoButton" Style="{StaticResource VS.ToolButton}" Click="Undo_Click" Height="32" ToolTip="撤销 (Ctrl+Z)">
                                <Image Source="/Assets/Icons/Undo_16x.png" Width="16" Height="16" />
                            </Button>
                            <Button x:Name="RedoButton" Style="{StaticResource VS.ToolButton}" Click="Redo_Click" Height="32" ToolTip="重做 (Ctrl+Y)">
                                <Image Source="/Assets/Icons/Redo_16x.png" Width="16" Height="16" />
                            </Button>
                            <Border Background="#464649" Width="1" Margin="7,8,7,8" />
                            <Button x:Name="PlayButton" Style="{StaticResource VS.ToolButton}" Click="PlayPause_Click" Height="32" ToolTip="播放 / 暂停 (F5)">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Assets/Icons/Run_16xMD.png" Width="16" Height="16" />
                                    <TextBlock Text="运行" Margin="5,0,1,0" VerticalAlignment="Center" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="StopButton" Style="{StaticResource VS.ToolButton}" Click="StopPreview_Click" Height="32" ToolTip="停止 (Shift+F5)">
                                <Image Source="/Assets/Icons/Stop_16x.png" Width="16" Height="16" />
                            </Button>
                            <Border Background="#464649" Width="1" Margin="7,8,7,8" />
                            <Button x:Name="AddTrackButton" Style="{StaticResource VS.ToolButton}" Click="AddTrack_Click" Height="32" ToolTip="添加轨道">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Assets/Icons/Timeline_16x.png" Width="16" Height="16" />
                                    <TextBlock Text="轨道" Margin="5,0,1,0" VerticalAlignment="Center" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ValidateButton" Style="{StaticResource VS.ToolButton}" Click="Validate_Click" Height="32" ToolTip="验证工程 (F7)">
                                <Image Source="/Assets/Icons/Refresh_16x.png" Width="16" Height="16" />
                            </Button>
                            <Border Background="#464649" Width="1" Margin="7,8,7,8" />
                            <Button x:Name="ExportButton" Style="{StaticResource VS.ToolButton}" Click="Export_Click" Height="32" ToolTip="导出完整 AgSTG 解决方案 (Ctrl+E)">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Assets/Icons/ExportFile_16x.png" Width="16" Height="16" />
                                    <TextBlock Text="导出" Margin="5,0,1,0" VerticalAlignment="Center" FontSize="11" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock x:Name="EnginePathText" Text="" FontSize="10" Foreground="#7A7A7A" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Button x:Name="AccentExportButton" Style="{StaticResource VS.AccentButton}" Click="Export_Click" Height="27" Padding="14,2">
                                导出解决方案
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ================= 主区域 ================= -->
                <Grid Grid.Row="3" x:Name="WorkspaceGrid" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="248" MinWidth="190" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" MinWidth="460" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="312" MinWidth="260" />
                    </Grid.ColumnDefinitions>

                    <local:ProjectExplorer x:Name="Explorer" Grid.Column="0" />
                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="#181818" />

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="31" />
                            <RowDefinition Height="*" />
                            <RowDefinition x:Name="OutputSplitterRow" Height="4" />
                            <RowDefinition x:Name="OutputRow" Height="168" />
                        </Grid.RowDefinitions>

                        <Border Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="TabTimeline" Style="{StaticResource VS.DocTab}" GroupName="DocTabs" Tag="timeline" IsChecked="True" Checked="Tab_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/Icons/Timeline_16x.png" Width="14" Height="14" Margin="0,0,6,0" />
                                        <TextBlock Text="时间轴" FontSize="11.5" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="TabBlocks" Style="{StaticResource VS.DocTab}" GroupName="DocTabs" Tag="blocks" Checked="Tab_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/Icons/Toolbox_16x.png" Width="14" Height="14" Margin="0,0,6,0" />
                                        <TextBlock Text="积木编程" FontSize="11.5" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="TabBackground" Style="{StaticResource VS.DocTab}" GroupName="DocTabs" Tag="background" Checked="Tab_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/Icons/Media_16x.png" Width="14" Height="14" Margin="0,0,6,0" />
                                        <TextBlock Text="背景编辑" FontSize="11.5" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="TabPreview" Style="{StaticResource VS.DocTab}" GroupName="DocTabs" Tag="preview" Checked="Tab_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/Icons/PlaybackPreview_16x.png" Width="14" Height="14" Margin="0,0,6,0" />
                                        <TextBlock Text="试玩预览" FontSize="11.5" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="TabCode" Style="{StaticResource VS.DocTab}" GroupName="DocTabs" Tag="code" Checked="Tab_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/Icons/VBFile_16x.png" Width="14" Height="14" Margin="0,0,6,0" />
                                        <TextBlock Text="代码预览" FontSize="11.5" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="TabResources" Style="{StaticResource VS.DocTab}" GroupName="DocTabs" Tag="resources" Checked="Tab_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/Icons/Folder_16x.png" Width="14" Height="14" Margin="0,0,6,0" />
                                        <TextBlock Text="游戏资源" FontSize="11.5" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1">
                            <local:TimelineEditor x:Name="TimelineEditorView" />
                            <local:BlockEditorView x:Name="BlockEditorViewControl" Visibility="Collapsed" />
                            <local:BackgroundEditor x:Name="BackgroundEditorView" Visibility="Collapsed" />
                            <local:PreviewPanel x:Name="PreviewPanelControl" Visibility="Collapsed" />
                            <local:CodePreviewView x:Name="CodePreviewControl" Visibility="Collapsed" />
                            <local:GameResourceManager x:Name="ResourceManagerView" Visibility="Collapsed" />
                        </Grid>

                        <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="#181818" />
                        <local:OutputPanel x:Name="OutputView" Grid.Row="3" />
                    </Grid>

                    <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="#181818" />

                    <Grid Grid.Column="4" x:Name="RightColumnGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="180" />
                            <RowDefinition Height="4" />
                            <RowDefinition Height="330" MinHeight="200" />
                        </Grid.RowDefinitions>
                        <local:BlockPaletteView x:Name="PaletteView" />
                        <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="#181818" />
                        <local:PropertyPanel x:Name="PropertyView" Grid.Row="2" />
                    </Grid>
                </Grid>

                <Border x:Name="EmptyWorkspace" Grid.Row="3" Visibility="Visible" >
                    <Border.Background>
                        <ImageBrush ImageSource="/Assets/Window/background.png" Stretch="None" TileMode="None"/>
                    </Border.Background>
                </Border>

                <!-- ================= 状态栏 ================= -->
                <Border x:Name="StatusBar" Grid.Row="4" Background="#FF0179CB">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Source="/Assets/Icons/StatusRun_16x.png" Width="13" Height="13" Margin="10,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusLeftText" Grid.Column="1" Text="就绪" Style="{StaticResource VS.StatusText}" />
                        <TextBlock x:Name="ValidationStatusText" Grid.Column="3" Text="0 个错误 · 0 个警告" Style="{StaticResource VS.StatusText}" Margin="0,0,18,0" Opacity="0.95" />
                        <TextBlock x:Name="TickStatusText" Grid.Column="4" Text="Tick 0 / 3600" Style="{StaticResource VS.StatusText}" Margin="0,0,18,0" />
                        <TextBlock x:Name="ViewStatusText" Grid.Column="5" Text="时间轴 · 100%" Style="{StaticResource VS.StatusText}" Margin="0,0,12,0" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </local:AccentGlowDecorator>
</Window>
