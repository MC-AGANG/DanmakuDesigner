<Window x:Class="ToolWindow_ItemEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DanmakuDesigner"
        xmlns:AGC="clr-namespace:AgControls;assembly=AgControls"
        mc:Ignorable="d"
        Title="掉落物编辑器" Height="280" Width="240" WindowStyle="None" ResizeMode="NoResize" Background="#FF1E1E1E" WindowStartupLocation="CenterScreen">
    <Grid Margin="8,8,8,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
            <RowDefinition/>
            <RowDefinition Height="48"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Label Content="物品" Grid.Row="0" Foreground="White"/>
        <Label Content="P点" Grid.Row="1" Foreground="White"/>
        <Label Content="蓝点" Grid.Row="2" Foreground="White"/>
        <Label Content="残机" Grid.Row="3" Foreground="White"/>
        <Label Content="残机碎片" Grid.Row="4" Foreground="White"/>
        <Label Content="符卡" Grid.Row="5" Foreground="White"/>
        <Label Content="符卡碎片" Grid.Row="6" Foreground="White"/>

        <Label Content="数量" Grid.Row="0" Grid.Column="1" Foreground="White"/>
        <TextBox Name="TB_Power" Grid.Row="1" Grid.Column="1" Foreground="White" Background="#FF1F1F1F" BorderBrush="#FF424242" SelectionBrush="#FF353535"/>
        <TextBox Name="TB_Point" Grid.Row="2" Grid.Column="1" Foreground="White" Background="#FF1F1F1F" BorderBrush="#FF424242" SelectionBrush="#FF353535"/>
        <TextBox Name="TB_Life" Grid.Row="3" Grid.Column="1" Foreground="White" Background="#FF1F1F1F" BorderBrush="#FF424242" SelectionBrush="#FF353535"/>
        <TextBox Name="TB_LifePiece" Grid.Row="4" Grid.Column="1" Foreground="White" Background="#FF1F1F1F" BorderBrush="#FF424242" SelectionBrush="#FF353535"/>
        <TextBox Name="TB_Spell" Grid.Row="5" Grid.Column="1" Foreground="White" Background="#FF1F1F1F" BorderBrush="#FF424242" SelectionBrush="#FF353535"/>
        <TextBox Name="TB_SpellPiece" Grid.Row="6" Grid.Column="1" Foreground="White" Background="#FF1F1F1F" BorderBrush="#FF424242" SelectionBrush="#FF353535"/>

        <Button Name="BT_Apply" Grid.Column="0" Grid.Row="8" Margin="8" Content="确定" Click="BT_Apply_Click"/>
        <Button Name="BT_Cancel" Grid.Column="1" Grid.Row="8" Margin="8" Content="取消" Click="BT_Cancel_Click"/>
    </Grid>
</Window>
